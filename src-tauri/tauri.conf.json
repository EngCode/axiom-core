{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Core",
  "version": "0.1.0",
  "identifier": "com.axiom.core",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Abdullah Ramadan",
    "copyright": "Copyright \u00a9 2026 Abdullah Ramadan",
    "category": "Productivity",
    "shortDescription": "A private local-first workspace for independent work.",
    "longDescription": "Axiom Core is a desktop workspace for projects, tasks, documents, notes and media. Local SQLite, no account, no telemetry.",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/seed/axiom.db": "seed/axiom.db"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
