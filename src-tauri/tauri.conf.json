{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Core",
  "version": "0.2.0",
  "identifier": "com.axiom.core",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Abdullah Ramadan",
    "copyright": "Copyright \u00a9 2026 Abdullah Ramadan",
    "category": "Productivity",
    "shortDescription": "A private local-first workspace for independent work.",
    "longDescription": "Axiom Core is a desktop workspace for projects, tasks, documents, notes and media. Local SQLite, no account, no telemetry.",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/seed/axiom.db": "seed/axiom.db"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNUFCODBFREZBNDg5QjUKUldTMWlhVGZEcmhhbzVZaHFSRlZtK0RoVlJCL3pGaVBkQXJTdmFvMk94Qk54NGs1TmkzQ1VRNEwK",
      "endpoints": [
        "https://github.com/EngCode/axiom-core/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
